{
  "name": "tgfx-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "docs"
  ],
  "scripts": {
    "specs": "bun --cwd packages/react-native-tgfx run specs",
    "typecheck": "bun --cwd packages/react-native-tgfx run typecheck",
    "example": "bun --cwd apps/example",
    "release": "bash scripts/release.sh",
    "bootstrap": "bash scripts/tgfx-prebuilt.sh"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "release-it": "^21.0.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.127.1"
  },
  "patchedDependencies": {
    "react-native-vision-camera@5.2.0": "patches/react-native-vision-camera@5.2.0.patch",
    "@react-native-harness/runtime@1.3.0": "patches/@react-native-harness%2Fruntime@1.3.0.patch"
  }
}
