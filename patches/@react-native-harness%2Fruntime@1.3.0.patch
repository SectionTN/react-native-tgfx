+// Patched: defining `globalThis.jest` on the device runtime makes every
+// library's `typeof jest !== 'undefined'` Jest detection fire. Reanimated
+// then swaps in its Jest mocks (plain-object mutables), so every mapper on
+// the real UI runtime dies against remote functions — shared values and
+// value-slot writes silently stop repainting under the harness while
+// working fine in the real app. The friendly "use harness.fn()" warning is
+// not worth that: an absent global already throws a clear ReferenceError.
+export const setupJestMock = () => {};
