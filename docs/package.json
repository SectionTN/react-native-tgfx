{
  "name": "@tgfx/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docs:api": "typedoc --options typedoc.config.mts",
    "dev": "bun run docs:api && fumadocs-mdx && next dev",
    "build": "bun run docs:api && fumadocs-mdx && next build",
    "start": "next start",
    "clean": "rm -rf .next .source content/api",
    "postinstall": "fumadocs-mdx",
    "preview": "bun run docs:api && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "bun run docs:api && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "16.14.0",
    "lucide-react": "^1.31.0",
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.1.14",
    "typedoc": "0.28.19",
    "typedoc-plugin-frontmatter": "1.3.1",
    "typedoc-plugin-markdown": "4.11.0",
    "typescript": "^5.7.2",
    "wrangler": "4.118.0"
  }
}
