{
  "name": "react-native-tgfx",
  "version": "0.0.2-alpha.0",
  "description": "A declarative, Skia-style GPU 2D canvas for React Native, backed by Tencent's tgfx and built with Nitro Modules.",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/consumer-rules.pro",
    "android/src",
    "scripts",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "ios/libs",
    "app.plugin.js",
    "nitro.json",
    "*.podspec",
    "README.md",
    "LICENSE",
    "NOTICE",
    "cpp/*.cpp",
    "cpp/*.hpp",
    "cpp/third_party/tgfx/CMakeLists.txt",
    "cpp/third_party/tgfx/DEPS",
    "cpp/third_party/tgfx/vendor.json",
    "cpp/third_party/tgfx/LICENSE.txt",
    "cpp/third_party/tgfx/include",
    "cpp/third_party/tgfx/third_party",
    "cpp/third_party/tgfx/src",
    "cpp/third_party/tgfx/android",
    "cpp/third_party/tgfx/ios",
    "cpp/third_party/tgfx/mac"
  ],
  "scripts": {
    "prepack": "npx --no-install tsc --build --force && ls lib/index.js lib/index.d.ts LICENSE NOTICE > /dev/null",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf android/build node_modules/**/android/build lib tsconfig.tsbuildinfo",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "lint:check": "eslint \"**/*.{js,ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typescript": "tsc",
    "specs": "tsc --noEmit false && nitrogen --logLevel=\"debug\""
  },
  "keywords": [
    "react-native",
    "nitro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riteshshukla04/react-native-tgfx.git"
  },
  "author": "Ritesh Shukla <riteshkumarshukla04@gmail.com> (https://github.com/riteshshukla04)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/riteshshukla04/react-native-tgfx/issues"
  },
  "homepage": "https://github.com/riteshshukla04/react-native-tgfx#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release react-native-tgfx ${version}",
      "tagName": "react-native-tgfx@${version}",
      "tagMatch": "react-native-tgfx@*",
      "requireBranch": "main"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "github": {
      "release": true,
      "releaseName": "react-native-tgfx ${version}"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        },
        "infile": "CHANGELOG.md",
        "tagOpts": {
          "prefix": "react-native-tgfx@"
        },
        "commitsOpts": {
          "path": "."
        },
        "gitRawCommitsOpts": {
          "path": "."
        },
        "ignoreRecommendedBump": true
      }
    }
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.85.3",
    "@types/react": "^19.2.15",
    "@types/react-reconciler": "0.33.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nitrogen": "*",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-modules": "*",
    "react-native-reanimated": "^4.4.0",
    "react-native-worklets": "^0.11.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "react-reconciler": "0.33.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*",
    "react-native-reanimated": "*",
    "react-native-worklets": "*"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  }
}
