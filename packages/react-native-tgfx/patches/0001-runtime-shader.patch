+namespace tgfx {
+class RuntimeShader : public Shader {
+ public:
+  explicit RuntimeShader(std::shared_ptr<RuntimeShaderSource> source) : source(std::move(source)) {
+  }
+
+ protected:
+  Type type() const override {
