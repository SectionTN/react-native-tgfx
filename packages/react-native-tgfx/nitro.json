{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "tgfx"
  ],
  "ios": {
    "iosModuleName": "NitroTgfx"
  },
  "android": {
    "androidNamespace": [
      "tgfx"
    ],
    "androidCxxLibName": "NitroTgfx"
  },
  "autolinking": {
    "TgfxView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridTgfxView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridTgfxView"
      }
    },
    "TgfxImageFactory": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridTgfxImageFactory"
      }
    },
    "TgfxFonts": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridTgfxFonts"
      }
    },
    "TgfxSlotsFactory": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridTgfxSlotsFactory"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
